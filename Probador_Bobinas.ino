// ---------- Pines y Constantes del Sistema ----------
const int   PIN_POT   = 3;     
const int   PIN_PWM   = 4;     
const int   PIN_SDA   = 8;     
const int   PIN_SCL   = 9;     

const int   FREQ_MIN  = 10;    
const int   FREQ_MAX  = 200;   
const float DWELL_MS  = 3.0;   
const float DUTY_MAX  = 0.40;  

const int   RES_BITS  = 14;
const uint32_t DUTY_FULL = (1UL << RES_BITS) - 1;

#if !defined(ESP_ARDUINO_VERSION_MAJOR) || ESP_ARDUINO_VERSION_MAJOR < 3
  #define CORE_V2              
  const int PWM_CHANNEL = 0;
#endif

int      freqActual = 0;
uint32_t lastOled = 0;
bool     hayOled = false;

uint32_t freqReal() {
#ifdef CORE_V2
  return ledcReadFreq(PWM_CHANNEL);
#else
  return ledcReadFreq(PIN_PWM);
#endif
}

bool aplicarPwm(int freq, uint32_t duty) {
#ifdef CORE_V2
  bool ok = ledcChangeFrequency(PWM_CHANNEL, freq, RES_BITS) != 0;
  ledcWrite(PWM_CHANNEL, duty);
#else
  bool ok = ledcChangeFrequency(PIN_PWM, freq, RES_BITS) != 0;
  ledcWrite(PIN_PWM, duty);
#endif
  return ok;
}

uint32_t dutyParaDwell(int freq) {
  float dutyFrac = DWELL_MS * freq / 1000.0f;
  if (dutyFrac > DUTY_MAX) dutyFrac = DUTY_MAX;
  return dutyFrac * DUTY_FULL;
}

void setup() {
  Serial.begin(115200);
  Wire.begin(PIN_SDA, PIN_SCL);

  if(display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    hayOled = true;
    display.clearDisplay();
    display.drawBitmap(0, 2, epd_bitmap_Logo_SISU, 128, 64, WHITE);
    display.fillRect(0, 55, 128, 9, BLACK); 
    display.display();
    delay(2000);
  }

  analogReadResolution(12);

#ifdef CORE_V2
  ledcSetup(PWM_CHANNEL, FREQ_MIN, RES_BITS);
  ledcAttachPin(PIN_PWM, PWM_CHANNEL);
  bool pwmOk = true;
#else
  bool pwmOk = ledcAttach(PIN_PWM, FREQ_MIN, RES_BITS);
#endif

  if (!pwmOk) {
    while (true) delay(1000);
  }

  freqActual = FREQ_MIN;
  aplicarPwm(FREQ_MIN, dutyParaDwell(FREQ_MIN));
}

void loop() {
  long suma = 0;
  for (int i = 0; i < 16; i++) suma += analogRead(PIN_POT);
  int adc = suma / 16;

  int freq = map(adc, 0, 4095, FREQ_MIN, FREQ_MAX);

  if (abs(freq - freqActual) >= 2) {
    freqActual = freq;
    aplicarPwm(freqActual, dutyParaDwell(freqActual));
  }

  if (millis() - lastOled >= 200) {
    lastOled = millis();
    int rpm = freqActual * 30; 
    int dutyPct = int(100.0f * dutyParaDwell(freqActual) / DUTY_FULL);

    if (hayOled) {
      display.clearDisplay();
      
      // 1. Encabezado limpio y compacto (Tamaño 1)
      display.setTextSize(1);
      display.setTextColor(WHITE);
      display.setCursor(0, 0);
      display.print(F("PROBADOR DE BOBINAS"));
      
      // Línea divisoria delgada
      display.drawFastHLine(0, 10, 128, WHITE);

      // 2. RPM destacadas en tamaño grande (Tamaño 2) para verlas fácil
      display.setTextSize(2);
      display.setCursor(0, 15);
      display.print(rpm);
      display.setTextSize(1);
      display.setCursor(82, 21);
      display.print(F("RPM"));

      // 3. Frecuencia y Dwell en la parte inferior con espacio holgado
      display.setCursor(0, 39);
      display.print(F("Freq: "));
      display.print(freqReal());
      display.print(F("Hz"));

      display.setCursor(0, 52);
      display.print(F("Dwell:"));
      display.print(DWELL_MS, 1);
      display.print(F("ms  D:"));
      display.print(dutyPct);
      display.print(F("%"));

      display.display();
    }
  }
}